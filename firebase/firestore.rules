// 이 파일은 main 에 들어오면 GitHub Actions 가 테스트를 거쳐 배포한다 - 콘솔에서 고치지 않는다
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMine(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["staff", "admin"];
    }

    function onlyStockDown() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.stock >= 0;
    }

    function validPrice() {
      return request.resource.data.price is number
          && request.resource.data.price > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isStaff() && validPrice();
      allow update: if (isStaff() && validPrice())
                    || (signedIn() && onlyStockDown());
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isMine(resource.data.userId) || isStaff();
      allow create: if isMine(request.resource.data.userId);
      allow update: if isStaff();
    }

    match /users/{userId} {
      allow read: if isMine(userId);
    }

    match /pushTokens/{uid} {
      allow read, write: if isMine(uid);
    }

    match /adminLogs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
